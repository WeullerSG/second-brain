# Chave da API do Google Gemini (obrigatória para o Agente e Embeddings)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelos Gemini (Interactions API + Embeddings)
GEMINI_AGENT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Banco de Dados:
# - Para rodar imediatamente sem Docker (SQLite + Vetores locais):
DATABASE_URL=sqlite:///./data/second_brain.db
# - Para rodar com PostgreSQL + pgvector (Docker, Supabase ou Neon):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/secondbrain

# Diretório para salvar arquivos enviados no RAG
UPLOAD_DIR=./data/uploads

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
